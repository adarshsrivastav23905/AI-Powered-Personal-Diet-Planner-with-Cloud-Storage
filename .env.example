# ═══════════════════════════════════════════════════════════
# AI-Powered Personal Diet Planner - Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!

# ── Flask Configuration ───────────────────────────────────
FLASK_ENV=development
PORT=5000
SECRET_KEY=your-secret-key-change-this-in-production

# ── JWT Configuration ─────────────────────────────────────
JWT_SECRET=your-jwt-secret-change-this-in-production
PASSWORD_SALT=your-password-salt-change-this

# ── AI API Configuration (Optional) ──────────────────────
# If not set, the rule-based engine will be used (Version A)
# AI_API_KEY=your-ai-api-key
# AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent

# ── Cloud Database Configuration (for production) ────────
# DATABASE_URL=your-cloud-database-url

# ── Cloud Storage Configuration (for production) ─────────
# STORAGE_BUCKET=your-storage-bucket-name
